generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SEEKER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpportunityType {
  INTERNSHIP
  SCHOLARSHIP
  EVENT
  HACKATHON
  WORKSHOP
  FELLOWSHIP
  VOLUNTEERING
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  REMOVED
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
  UNSPECIFIED
}

enum Compensation {
  PAID
  UNPAID
  FUNDED
  FREE
  UNSPECIFIED
}

enum TrackingStatus {
  SAVED
  APPLIED
  INTERVIEWING
  ACCEPTED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PortfolioStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ContentClass {
  TECH
  RESTRICTED
}

enum PlanCode {
  NONE
  FREE
  BASIC
  PREMIUM
}

enum BillingPeriod {
  NONE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile       Profile?
  organization  Organization?
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  savedItems    SavedItem[]
  applications  Application[]
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university     String   @default("")
  fieldOfStudy   String   @default("")
  educationLevel String   @default("")
  graduationYear Int?
  skills         String[]
  interests      String[]
  projects       Json     @default("[]")
  bio            String   @default("")
  careerGoals    String   @default("")
  portfolioUrl   String   @default("")
  photoUrl       String   @default("")
  phone          String   @default("")
  experiences    Json     @default("[]")
  certifications Json     @default("[]")
  template       String   @default("modern")
  slug           String?  @unique
  published      Boolean  @default(false)
  sourceNotes    Json     @default("{}")
  locations      String[]
  workModes      String[]
  aiSummary      String   @default("")
  completeness   Int      @default(0)
  visibility     String   @default("private")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Organization {
  id                 String             @id @default(uuid())
  ownerUserId        String             @unique
  owner              User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name               String
  description        String             @default("")
  industry           String             @default("")
  website            String             @default("")
  contactEmail       String             @default("")
  location           String             @default("")
  verificationStatus VerificationStatus @default(PENDING)
  reviewReason       String             @default("")
  portfolioStatus    PortfolioStatus    @default(APPROVED)
  portfolioNote      String             @default("")
  restrictedPosts    Int                @default(0)
  logoUrl            String             @default("")
  phone              String             @default("")
  profileSubmitted   Boolean            @default(false)
  plan               PlanCode           @default(NONE)
  billingPeriod      BillingPeriod      @default(NONE)
  subscriptionStatus SubscriptionStatus @default(NONE)
  subscriptionEndsAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  opportunities      Opportunity[]
  payments           Payment[]
  campaigns          Campaign[]
}

model Opportunity {
  id               String            @id @default(uuid())
  orgId            String
  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title            String
  type             OpportunityType
  category         String
  description      String
  responsibilities String            @default("")
  eligibility      String            @default("")
  audience         String            @default("")
  requiredSkills   String[]
  location         String            @default("")
  latitude         Float?
  longitude        Float?
  workMode         WorkMode          @default(UNSPECIFIED)
  compensation     Compensation      @default(UNSPECIFIED)
  duration         String            @default("")
  closesAt         DateTime?
  startsAt         DateTime?
  applyUrl         String            @default("")
  applicationForm  Json              @default("[]")
  status           OpportunityStatus @default(DRAFT)
  contentClass     ContentClass      @default(TECH)
  banReason        String            @default("")
  viewCount        Int               @default(0)
  applyClicks      Int               @default(0)
  featured         Boolean           @default(false)
  promoted         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  savedItems       SavedItem[]
  applications     Application[]

  @@index([status, type, closesAt])
  @@index([orgId])
}

model SavedItem {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  trackingStatus TrackingStatus @default(SAVED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, opportunityId])
}

model Payment {
  id            String        @id @default(uuid())
  orgId         String
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan          PlanCode
  billingPeriod BillingPeriod
  amount        Int
  currency      String        @default("ETB")
  method        String
  payerName     String
  reference     String
  status        PaymentStatus @default(PENDING)
  reviewNote    String        @default("")
  createdAt     DateTime      @default(now())
  reviewedAt    DateTime?

  @@index([orgId, status])
}

model Campaign {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     String
  message   String
  audience  String       @default("")
  kind      String
  status    String       @default("ACTIVE")
  createdAt DateTime     @default(now())

  @@index([orgId])
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(PENDING)
  answers       Json              @default("{}")
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@unique([userId, opportunityId])
}
